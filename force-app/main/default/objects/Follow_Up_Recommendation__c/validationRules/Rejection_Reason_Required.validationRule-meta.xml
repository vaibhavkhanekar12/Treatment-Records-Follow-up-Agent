<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rejection_Reason_Required</fullName>
    <active>true</active>
    <description>Rejections are audited: a reason is required.</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &quot;Rejected&quot;), ISBLANK(Rejection_Reason__c))</errorConditionFormula>
    <errorDisplayField>Rejection_Reason__c</errorDisplayField>
    <errorMessage>Enter a rejection reason.</errorMessage>
</ValidationRule>
