<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Override_Reason_Required</fullName>
    <active>true</active>
    <description>Case-manager overrides are audited: a reason is required.</description>
    <errorConditionFormula>AND(Case_Manager_Override__c, ISBLANK(Override_Reason__c))</errorConditionFormula>
    <errorDisplayField>Override_Reason__c</errorDisplayField>
    <errorMessage>Enter an override reason.</errorMessage>
</ValidationRule>
